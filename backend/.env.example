# Optional local overrides. Defaults work without copying this file.
# Copy to backend/.env; never commit real credentials.
# Node tooling and Compose read this file. See README.md for precedence.

# Changes both the Compose host port and the generated local database URL.
CASCADE_DB_PORT=55432

# Optional complete override for local migration/check/Studio and the local Worker.
# DATABASE_URL=postgres://cascade:cascade_local_only@127.0.0.1:55432/cascade_springs

# Optional Node scaffold only (dev:node), not Wrangler's port.
PORT=3000
NODE_ENV=development

# Hosted Neon and Cloudflare configuration belongs in the workspace root
# .env.local. See ../.env.example for every hosted secret and public setting.
# Use pnpm backend:hosted:* for Neon; local commands retain Docker defaults.
# Do not put production database credentials into this local development file.
