      "checkConstraints": {
        "observation_owner_check": {
          "name": "observation_owner_check",
          "value": "(\"observation\".\"account_id\" IS NOT NULL AND length(trim(\"observation\".\"account_id\")) > 0 AND \"observation\".\"guest_secret_digest\" IS NULL)\n        OR (\"observation\".\"account_id\" IS NULL AND \"observation\".\"guest_secret_digest\" IS NOT NULL AND \"observation\".\"guest_secret_digest\" ~ '^[0-9a-f]{64}$')"
        },
        "observation_payload_digest_check": {
          "name": "observation_payload_digest_check",
          "value": "\"observation\".\"payload_digest\" ~ '^[0-9a-f]{64}$'"
        },
        "observation_location_check": {
          "name": "observation_location_check",
          "value": "(\"observation\".\"location\" IS NOT NULL AND \"observation\".\"location_unavailable_reason\" IS NULL\n        AND NOT ST_IsEmpty(\"observation\".\"location\")\n        AND ST_X(\"observation\".\"location\") BETWEEN -180 AND 180\n        AND ST_Y(\"observation\".\"location\") BETWEEN -90 AND 90)\n        OR (\"observation\".\"location\" IS NULL AND \"observation\".\"location_unavailable_reason\" IS NOT NULL\n        AND \"observation\".\"location_unavailable_reason\" IN ('permission_denied', 'unavailable', 'not_shared'))"
        },
        "observation_delivery_check": {
          "name": "observation_delivery_check",
          "value": "array_position(\"observation\".\"recipients\", NULL) IS NULL\n        AND array_position(\"observation\".\"recipients\", '') IS NULL\n        AND ((\"observation\".\"delivery_mode\" = 'park' AND cardinality(\"observation\".\"recipients\") = 1)\n          OR (\"observation\".\"delivery_mode\" = 'custom' AND cardinality(\"observation\".\"recipients\") > 0))"
        }
      },
