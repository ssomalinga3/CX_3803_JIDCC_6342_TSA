{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cascade-springs-api-local",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
    },
  ],
  "env": {
    "production": {
      "name": "cascade-springs-api",
      "account_id": "9b52bc25ebc019f660636e493cc8ad51",
      "workers_dev": true,
      "preview_urls": false,
      "observability": {
        "enabled": false,
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "463ed66cfeaa43179f85b9bb0d3eecbd",
        },
      ],
    },
  },
}
