# Hosted backend configuration. Copy to .env.local at the workspace root.
# neon deploy / neon env pull fills the Neon-managed values in that private file.
# Never commit actual passwords or tokens. Local Docker uses backend/.env instead.

# Neon application URL (pooled); retained as supplied by neon env pull.
DATABASE_URL=""
# Direct Neon URL: required by backend:hosted:migrate/check/import.
DATABASE_URL_UNPOOLED=""
# Separate direct read-only login used to provision Hyperdrive and hosted local dev.
CASCADE_RUNTIME_DB_URL=""

# Public deployment identifiers.
CLOUDFLARE_ACCOUNT_ID=9b52bc25ebc019f660636e493cc8ad51
API_ORIGIN=https://cascade-springs-api.dcc-6342-tsaa.workers.dev
NEON_BRANCH=production
# NEON_BRANCH_ID is populated by neon env pull.

# Optional for local deploys when Wrangler OAuth login is available.
# Required as a GitHub repository Actions secret for automatic deployment.
CLOUDFLARE_API_TOKEN=""

# GitHub Actions also needs DATABASE_URL_UNPOOLED as a repository secret.
# After merging the deployment workflow and setting both secrets, set the
# repository variable BACKEND_CD_ENABLED=true to enable automatic deployment.
# Local .env.local values are not automatically uploaded to GitHub.
